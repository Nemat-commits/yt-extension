{
  "name": "reframe-youtube-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A privacy-first, subscription-focused companion interface for YouTube. Native playback stays intact.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:manifest": "node scripts/audit-manifest.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run audit:manifest && npm run check:size"
  },
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/chrome": "^0.1.41",
    "@types/node": "^22.19.0",
    "@wxt-dev/module-svelte": "^2.0.5",
    "happy-dom": "^21.0.4",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
